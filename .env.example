# Lurelit Configuration
# Copy this file to .env.local and fill in your values

# Required: Full URL to your Kibana instance (no trailing slash)
# Append /s/space-name if using a non-default Kibana space
KIBANA_URL=https://your-kibana.elastic.cloud

# Required: Workflow ID auto-generated by Kibana after importing the workflow
# Find it: Security → Workflows → click your workflow → ID is in the URL
WORKFLOW_ID=your-workflow-id

# Optional: Secret for encrypting stored config and session cookies (AES-256-GCM)
# If omitted, uses an insecure default key (fine for local dev only)
CONFIG_SECRET=change-me-to-a-random-secret
